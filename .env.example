# mtb: переменные только для запуска.
# Устройства, расписание, хранение, Gitea, Telegram и пользователи
# настраиваются в веб-интерфейсе и хранятся в SQLite (DATA_DIR/mtb.db).

# Где лежат база, ключ шифрования секретов и known_hosts
# DATA_DIR=data
# Куда складывать бэкапы
# BACKUP_DIR=backups

# Адрес веб-интерфейса
# WEB_LISTEN=0.0.0.0:8080

# HTTPS без обратного прокси (пути к PEM-файлам)
# WEB_TLS_CERT=
# WEB_TLS_KEY=
# Флаг Secure у cookie: auto (= есть WEB_TLS_CERT) | true (HTTPS за прокси) | false
# WEB_COOKIE_SECURE=auto

# LOG_LEVEL=INFO

# Docker Compose: uid/gid владельца папок ./data и ./backups
# PUID=1000
# PGID=1000
